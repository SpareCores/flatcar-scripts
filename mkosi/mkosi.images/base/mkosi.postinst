#!/usr/bin/env bash
set -euo pipefail

[[ "${MKOSI_DEBUG:-0}" == "1" ]] && set -x

# shellcheck source=tools/bin/lib.sh
. "${SRCDIR}/lib/lib.sh"

root_fs_dir="${BUILDROOT:?BUILDROOT must be set by mkosi}"

echo "[postinst] customizing image at $root_fs_dir"

# we don't want this in the final image and /etc/portage is re-created by
# mkosi, so sysexts/overlay images don't need this
rm -rf "${root_fs_dir}/etc/portage"

# build_library/prod_image_util.sh create_prod_image():98-99 -- after the last
# emerge. sdk_emerge ran `env-update --no-ldconfig`, so /etc/ld.so.conf and
# /etc/{profile,csh}.env are already generated.
#
# The mkdir is for the SANDBOX's /sys, not the image: run_localedef chroots via
# setup_board's bwrap-$BOARD wrapper, which binds /sys unconditionally, but
# mkosi only provides it to hooks when devices=True (run.py:701) and postinst
# does not get that. An empty dir on the sandbox's tmpfs root is enough; nothing
# here reads /sys. DELETE once setup_board uses `--bind-try /sys /sys`.
mkdir -p /sys
run_ldconfig "${root_fs_dir}"    # build_image_util.sh:105
run_localedef "${root_fs_dir}"   # build_image_util.sh:110

# Stop here: this is the root create_prod_image() snapshots for sysexts
# (prod_image_util.sh:136-139). Sysexts build on %O/base, so the clean-ups
# and /etc freeze that follow live in the main image (mkosi.postinst.d/).
