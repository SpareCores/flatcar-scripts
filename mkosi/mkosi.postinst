#!/usr/bin/env bash
# SPDX-License-Identifier: LGPL-2.1-or-later
#
# Bake Flatcar's DEFAULT built-in sysexts (containerd-flatcar, docker-flatcar)
# into the disk. Mirrors upstream build_library/sysext_prod_builder
# create_prod_sysext(): each signed DDI is installed under the verity'd /usr at
#   /usr/share/flatcar/sysext/<name>.raw
# with a merge symlink
#   /etc/extensions/<name>.raw -> ../../usr/share/flatcar/sysext/<name>.raw
# so systemd-sysext merges them unconditionally at boot (no download, no
# enabled-sysext.conf toggle — that path is for version-coupled downloadable
# sysexts, not these baked-in defaults).
#
# ORDERING: this is a mkosi POSTINST (runs before the auto-discovered
# mkosi.finalize). That matters — the .raw must land in /usr BEFORE
# mkosi.finalize builds the dm-verity btrfs from /usr and seals it. A finalize
# script would be too late (the hash would not cover these files).
#
# The DDIs are built by the containerd-flatcar-sysext / docker-flatcar-sysext
# sub-images (top-level Dependencies=), landing in the shared mkosi.output/ that
# is bind-mounted at $SRCDIR.
set -euo pipefail

[[ "${MKOSI_DEBUG:-0}" == "1" ]] && set -x

root="${BUILDROOT:?BUILDROOT must be set by mkosi}"

# For BOARD and the /build bind that grub_install.sh reads GRUB and shim from.
. "${SRCDIR}/lib/lib.sh"

# grub_install.sh only generates the memdisk grub.cfg when the ESP has none, so
# seed it from upstream's file plus our one delta: selinux=0, as this tree
# builds no SELinux policy. The @@MOUNTUSR@@ sed repeats grub_install.sh's own.
esp="${root}/efi"
install -d "${esp}/flatcar/grub"
grub_tmp="$(mktemp -d)"
sed -e 's/@@MOUNTUSR@@/mount.usr=\/dev\/mapper\/usr verity.usr/' \
    -e 's/consoleblank=0 \$linux_root/consoleblank=0 selinux=0 $linux_root/' \
    "${BUILD_LIBRARY_DIR}/grub.cfg" > "${grub_tmp}/grub.cfg"
grep -q 'selinux=0' "${grub_tmp}/grub.cfg" || { echo "grub.cfg: selinux=0 sed did not apply" >&2; exit 1; }
tar cf "${esp}/flatcar/grub/grub.cfg.tar" -C "${grub_tmp}" grub.cfg
rm -rf "${grub_tmp}"

# build_image_util.sh finish_image():823-846, EFI target only: i386-pc and
# x86_64-xen need a loop-mounted disk, which does not exist yet.
case "${BOARD}" in
  amd64-usr) grub_target=x86_64-efi ;;
  arm64-usr) grub_target=arm64-efi ;;
esac
"${BUILD_LIBRARY_DIR}/grub_install.sh" \
    --board="${BOARD}" \
    --target="${grub_target}" \
    --verity \
    --skip_emerge \
    --esp_dir="${esp}" \
    --esp_part_label=EFI-SYSTEM

# Guarantee /oem-tree exists so the OEM partition's CopyFiles=/oem-tree:/ has a
# source even in no-profile builds. The oem-qemu profile stages a populated tree
# here via ExtraTrees + mkosi.oem-finalize; without a profile repart would fail
# ("Failed to open source file /buildroot/oem-tree") since CopyFiles of a missing
# source is fatal, not skipped. install -d is a no-op when the profile populated it.
install -d -m 0755 "${root}/oem-tree"

# Names must match the sub-images' Output=/ImageId=.
builtin_sysexts=(containerd-flatcar docker-flatcar)

sysext_dir="${root}/usr/share/flatcar/sysext"
ext_dir="${root}/etc/extensions"
install -d -m 0755 "${sysext_dir}" "${ext_dir}"

for name in "${builtin_sysexts[@]}"; do
    src="${SRCDIR}/mkosi.output/${name}.raw"
    if [[ ! -f "${src}" ]]; then
        echo "[builtin-sysext] ERROR: ${src} not found — was the ${name}-sysext sub-image built?" >&2
        exit 1
    fi

    install -m 0644 "${src}" "${sysext_dir}/${name}.raw"
    ln -sf "../../usr/share/flatcar/sysext/${name}.raw" "${ext_dir}/${name}.raw"
    echo "[builtin-sysext] baked ${name}.raw into /usr + /etc/extensions symlink"
done

# Generate /usr/share/licenses/licenses.json.bz2 in the verity'd /usr so it is
# always present even when a test masks the docker/containerd sysexts. Upstream
# ships this manifest; kola sysext.custom-docker.sysext reads the Docker version
# from it. Covers base + every sysext: each sysext saves its pkgdb via
# tools/save-pkgdb.sh and write-licenses.sh merges them before generating.
"${SRCDIR}/tools/write-licenses.sh"

# Re-create the first-boot marker. The base postinst writes it into the base
# tree, but it does not survive into the final image's /boot/flatcar (which
# mkosi repopulates with vmlinuz-a + microcode.initrd). Without it on the ESP,
# Ignition skips the first-boot path and initrd-setup-root-after-ignition
# instead tries to fetch an update payload, failing with GetRequestFailed(404).
install -d -m 0755 "${root}/boot/flatcar"
cat > "${root}/boot/flatcar/first_boot" <<EOF
If this file exists, Ignition will run and then delete the file.
EOF
