#!/bin/bash
# no-op sudo for SDK scripts running inside mkosi's sandbox.
#
# build_library/* call `sudo` liberally (sudo_clobber, sudo mkdir, ...). The
# sandbox has no /etc/sudoers, so the real sudo fails with
#   sudo: unable to open /etc/sudoers: No such file or directory
# Hooks already run as root there, so strip sudo's own options and exec the
# command directly. This is what lets the SDK scripts run verbatim.
set -euo pipefail

while [ "$#" -gt 0 ]; do
    case "$1" in
        -E|-H|-n|-s|-i)   shift ;;
        -u|-g|-p|-C)      shift 2 ;;
        --)               shift; break ;;
        -*)               shift ;;
        VAR=*|*=*)        export "${1?}"; shift ;;   # sudo VAR=val cmd
        *)                break ;;
    esac
done

[ "$#" -gt 0 ] || exit 0
exec "$@"
