#!/usr/bin/env bash
# install and build grub, similar to grub_install.sh
set -euo pipefail

[[ "${MKOSI_DEBUG:-0}" == "1" ]] && set -x

# mkosi exports ARCHITECTURE (x86-64/arm64) and EFI_ARCHITECTURE
case "${ARCHITECTURE:?mkosi should export ARCHITECTURE}" in
  x86-64) target="x86_64-efi" ;;
  arm64)  target="arm64-efi"  ;;
  *) echo "unsupported ARCHITECTURE=${ARCHITECTURE}" >&2; exit 1 ;;
esac
efi_arch="${EFI_ARCHITECTURE:?mkosi should export EFI_ARCHITECTURE}"
# root="${BUILDROOT:?}"
out="${BUILDROOT}/efi"
grub_src="${BUILDROOT}/usr/lib/grub/${target}"
grub_prefix="flatcar/grub"

[[ -d "${grub_src}" ]] || { echo "GRUB not installed at ${grub_src}" >&2; exit 1; }

# Modules embedded in the self-contained EFI image (no .mod on the ESP), so
# anything the memdisk grub.cfg insmods must be here. grub-mkimage pulls deps.
core_modules=(
  normal search test fat part_gpt search_fs_uuid xzio search_part_label
  terminal gptprio configfile memdisk tar echo read btrfs
  serial linux efi_gop efinet pgp http tftp tpm
  all_video
)

work="$(mktemp -d)"
trap 'rm -rf "${work}"' EXIT

# Point $root at the ESP, keep prefix=(memdisk) so the embedded grub.cfg loads
# from the memdisk. repart hasn't formatted the ESP yet, so find it by part label.
cat > "${work}/load.cfg" <<EOF
search --no-floppy --set root --part-label EFI-SYSTEM
set prefix=(memdisk)
set
EOF

# grub.cfg lives only in the memdisk, never on the ESP.
grub_cfg="${SRCDIR}/mkosi.images/grub/grub.cfg"
[[ -f "${grub_cfg}" ]] || { echo "missing ${grub_cfg}" >&2; exit 1; }
mkdir -p "${work}/memdisk"
cp "${grub_cfg}" "${work}/memdisk/grub.cfg"
tar cf "${work}/${grub_prefix##*/}.cfg.tar" -C "${work}/memdisk" grub.cfg

mkdir -p "${out}/EFI/boot"

sbat="${BUILDROOT}/usr/share/grub/sbat.csv"
"${BUILDROOT}/usr/bin/grub-mkimage" \
  --compression=xz \
  --format="${target}" \
  --directory="${grub_src}" \
  --config="${work}/load.cfg" \
  --memdisk="${work}/${grub_prefix##*/}.cfg.tar" \
  ${sbat:+--sbat "${sbat}"} \
  --output="${out}/EFI/boot/grub${efi_arch}.efi" \
  "${core_modules[@]}"

# shim is the default EFI bootloader; mm is the MOK manager.
install -m 0644 "${BUILDROOT}/usr/lib/shim/shim${efi_arch}.efi" \
  "${out}/EFI/boot/boot${efi_arch}.efi"
install -m 0644 "${BUILDROOT}/usr/lib/shim/mm${efi_arch}.efi" \
  "${out}/EFI/boot/mm${efi_arch}.efi"

echo "[grub] built efi/EFI/boot/{boot,grub,mm}${efi_arch}.efi"
